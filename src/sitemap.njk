---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
	<url>
		<loc>{{ site.baseurl }}/</loc>
		<priority>1</priority>
		<changefreq>hourly</changefreq>
	</url>
	<url>
		<loc>{{ site.baseurl }}/o-mne</loc>
		<priority>1</priority>
		<changefreq>hourly</changefreq>
	</url>
	<url>
		<loc>{{ site.baseurl }}/nette-guru</loc>
		<priority>1</priority>
		<changefreq>hourly</changefreq>
	</url>
{%- for post in collections.postsCs %}
	<url>
		<loc>{{ site.baseurl }}{{ post.url | noHtml }}</loc>
		<priority>1</priority>
		<changefreq>hourly</changefreq>
	</url>
{%- endfor %}
{%- if collections.postsEn | length %}
	<url>
		<loc>{{ site.baseurl }}/en/</loc>
		<priority>1</priority>
		<changefreq>hourly</changefreq>
	</url>
	<url>
		<loc>{{ site.baseurl }}/en/about</loc>
		<priority>1</priority>
		<changefreq>hourly</changefreq>
	</url>
{%- for post in collections.postsEn %}
	<url>
		<loc>{{ site.baseurl }}{{ post.url | noHtml }}</loc>
		<priority>1</priority>
		<changefreq>hourly</changefreq>
	</url>
{%- endfor %}
{%- endif %}
</urlset>
