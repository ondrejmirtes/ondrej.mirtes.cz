<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
	<channel>
	<title>{{ site.name }}</title>
	<description>{{ site.description }}</description>
	<link>{{ site.baseurl }}/</link>
	<language>{{ (i18n[lang]).htmlLang }}</language>
	<copyright>{{ site.name }}</copyright>
	<pubDate>{{ site.buildTime | rfc822 }}</pubDate>
	<lastBuildDate>{{ site.buildTime | rfc822 }}</lastBuildDate>
	<generator>{{ site.name }}</generator>
	<ttl>30</ttl>
	<atom:link href="{{ site.baseurl }}{{ page.url }}" rel="self" type="application/rss+xml" />
	<image>
		<title>{{ site.name }}</title>
		<url>{{ site.baseurl }}/apple-touch-icon-precomposed.png</url>
		<link>{{ site.baseurl }}/</link>
		<description>{{ site.description }}</description>
	</image>

	{{ content | safe }}
	</channel>
</rss>
