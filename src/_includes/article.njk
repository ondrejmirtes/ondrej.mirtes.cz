{# Renders one article. Link posts (external_url) get an h3 linking out;
   regular articles get an h2 (linked back to the post when `link`). #}
{% macro article(title, externalUrl, cleanUrl, date, content, link) %}
<article class="mb-12 pb-4 border-b border-[#dde1e3] last:border-0">
  {% if externalUrl %}
    <h3 class="mb-3 text-xl">
      <a href="{{ externalUrl }}" class="text-[#c41700] hover:text-[#2a2f33]">{{ title }} <span aria-hidden="true">→</span></a>
    </h3>
  {% else %}
    <h2 class="mb-3 text-[26px] leading-tight text-[#2a2f33]">
      {% if link %}<a href="{{ cleanUrl }}" class="hover:text-[#db311a]">{{ title }}</a>{% else %}{{ title }}{% endif %}
    </h2>
  {% endif %}

  <time datetime="{{ date | isoDate }}" class="block mb-4 text-[15px] text-[#999]">
    <a href="{{ cleanUrl }}" class="text-[#999] hover:text-[#999] border-b border-transparent hover:border-[#b7bfc4]">{{ date | postDate }}</a>
  </time>

  <div class="prose max-w-none
      prose-headings:text-[#c41700] prose-headings:font-normal
      prose-a:text-[#2a2f33] prose-a:no-underline prose-a:border-b prose-a:border-[#a5abae]
      prose-a:hover:text-[#db311a] prose-a:hover:border-[#db311a]
      prose-code:font-mono prose-pre:bg-[#efefef] prose-pre:text-[#2a2f33]
      prose-blockquote:not-italic prose-img:mx-auto">
    {{ content | safe }}
  </div>
</article>
{% endmacro %}
